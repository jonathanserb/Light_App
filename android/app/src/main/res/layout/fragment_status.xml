<?xml version="1.0" encoding="utf-8"?>
<!-- The Status tab. Code: ui/StatusFragment.java -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="6dp">

        <com.google.android.material.card.MaterialCardView style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/CardTitle"
                    android:text="Clock" />

                <TextView
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall" />

                <TextView
                    android:id="@+id/clock_warning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Not set – schedules will not run until the clock is set."
                    android:textColor="?attr/colorError" />

                <TextView
                    style="@style/SmallText"
                    android:text="Set automatically from this phone each time you connect. The Pico forgets the time if it loses power." />

                <Button
                    android:id="@+id/sync"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Set clock now" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/CardTitle"
                    android:text="Device" />

                <!-- StatusFragment adds one row_fact.xml here per fact. -->
                <LinearLayout
                    android:id="@+id/facts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/CardTitle"
                    android:text="Settings" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Three equal-width buttons: width 0 + weight 1 shares the row. -->
                    <Button
                        android:id="@+id/rename"
                        style="@style/OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:paddingHorizontal="4dp"
                        android:text="Rename" />

                    <Button
                        android:id="@+id/passcode"
                        style="@style/OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:paddingHorizontal="4dp"
                        android:text="Passcode" />

                    <Button
                        android:id="@+id/reboot"
                        style="@style/OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:paddingHorizontal="4dp"
                        android:text="Reboot" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
