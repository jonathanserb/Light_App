<?xml version="1.0" encoding="utf-8"?>
<!-- The pop-up for adding or editing a schedule. Code: ui/ScheduleDialog.java,
     which hides the rows that don't apply to the chosen action. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp">

        <!-- Shows the time; tapping opens a clock to pick another. -->
        <Button
            android:id="@+id/time"
            style="@style/OutlinedButton"
            android:textAppearance="?attr/textAppearanceHeadlineSmall" />

        <!-- ScheduleDialog adds one chip per weekday. -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/TextBox"
            android:hint="Name (optional)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLength="24"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- What to do: switch a pin, dim a pin, start a program, stop the program. -->
        <Button
            android:id="@+id/action"
            style="@style/OutlinedButton"
            android:layout_marginTop="8dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/pin_box"
            style="@style/TextBox"
            android:hint="Pin (GP number, or LED)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/pin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:id="@+id/on_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Turn it on" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/on"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/duty_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/duty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="1"
            android:valueFrom="0"
            android:valueTo="100"
            app:tickVisible="false" />

        <!-- Which program to start. -->
        <Button
            android:id="@+id/program"
            style="@style/OutlinedButton" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/duration_box"
            style="@style/TextBox"
            android:hint="Undo after (seconds)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/duration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="5"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Says what is missing if Save is pressed too early. -->
        <TextView
            android:id="@+id/problem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="?attr/colorError"
            android:visibility="gone" />

        <Button
            android:id="@+id/delete"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delete schedule"
            android:textColor="?attr/colorError" />
    </LinearLayout>
</ScrollView>
